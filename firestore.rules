rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // MeLife verileri + MeDebit config (users/{uid}/app/config):
    // her kullanıcı yalnızca kendi klasörüne erişir
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Para verileri (eski MeDebit koleksiyonları): belge sahibi userId alanıyla belirlenir
    match /{col}/{id} {
      function isFinance() {
        return col in ['assets', 'debts', 'transactions', 'savingsGoals', 'cashflows', 'budgetLimits'];
      }
      allow read, delete: if isFinance() && signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isFinance() && signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isFinance() && signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
